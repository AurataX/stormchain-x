# Copy to .env for Compose. Generate unique local values before starting.
POSTGRES_PASSWORD=replace-with-local-password
OPERATOR_TOKEN=replace-with-at-least-24-random-characters
# Direct local Python uses SQLite unless DATABASE_URL is set explicitly.
# DATABASE_URL=sqlite+aiosqlite:///./stormchain.db
# Optional: POST /api/v1/briefings (Gemini plan explanations). Unset = 503, disabled.
# Server-side only; never expose this to the browser (no NEXT_PUBLIC_ prefix).
# GEMINI_API_KEY=replace-with-a-generativelanguage-restricted-key
# Alternative to the key above: Vertex AI via `gcloud auth application-default login`.
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# VERTEX_MODEL=gemini-3.5-flash
